# Copy to .env for local runs (`npm run dev` / `npm start` load it automatically).
# docker compose does not read this file; it sets its own values.

PORT=3000

# postgres://user:password@host:port/database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/balance
REDIS_URL=redis://localhost:6379

# Identifies this instance in task run history and lock values. Defaults to the hostname.
SERVER_ID=local-1

# Set to false to run an API-only instance that never executes scheduled tasks.
SCHEDULER_ENABLED=true

# Task lock TTL. The lock is renewed every TTL/3 while a task runs, so this only
# bounds how long a crashed instance can block a task.
LOCK_TTL_MS=30000

# Insert user 1 (balance 10000) and the demo tasks on startup. Idempotent.
SEED_DEMO_DATA=true

# How long shutdown waits for running tasks before aborting them.
SHUTDOWN_TIMEOUT_MS=10000
