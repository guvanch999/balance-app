{
  "name": "balance-app",
  "version": "2.0.0",
  "scripts": {
    "test": "node --test \"test/unit/**/*.test.js\"",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "test:integration": "node --test --test-concurrency=1 \"test/integration/**/*.test.js\"",
    "test:all": "npm test && npm run test:integration"
  },
  "author": "Guvanch D.",
  "license": "MIT",
  "description": "Correctness under concurrency: atomic balance updates in Postgres and a distributed cron with a safe Redis lock",
  "type": "commonjs",
  "dependencies": {
    "cron": "^4.4.0",
    "express": "^5.3.0",
    "ioredis": "^5.11.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "ioredis-mock": "^8.13.1"
  },
  "engines": {
    "node": ">=22.9"
  },
  "private": true,
  "keywords": [
    "concurrency",
    "postgresql",
    "redis",
    "distributed-lock",
    "cron",
    "express",
    "nodejs"
  ]
}
